{
	"format_version": "1.26.40",
	"minecraft:block": {
		"description": {
			"identifier": "flax:thatch_carpet",
			"menu_category": {
				"category": "none",
				"is_hidden_in_commands": true
			},
			"traits": {
				"minecraft:placement_direction": {
					"enabled_states": ["minecraft:facing_direction"]
				}
			}
		},
		"components": {
			"minecraft:friction": 0.4,
			"minecraft:map_color": "#caa851",
			"minecraft:flammable": {
				"catch_chance_modifier": 60, 
				"destroy_chance_modifier": 20
			},
			"minecraft:destructible_by_explosion": {
				"explosion_resistance": 10
			},
			"minecraft:destructible_by_mining": {
				"seconds_to_destroy": 0.1
			},
			"minecraft:liquid_detection": {
				"detection_rules": [
					{
						"liquid_type": "water",
						"on_liquid_touches": "popped",
						"can_contain_liquid": true
					}
				]
			},
			"minecraft:material_instances": {
				"*": {
					"texture": "thatch_side"
				},
				"up": {
					"texture": "thatch_top"
				},
				"down": {
					"texture": "thatch_top"
				}
			},
			"minecraft:collision_box": {
				"origin": [-8, 0, -8],
				"size": [16, 1, 16]
			},
			"minecraft:selection_box": {
				"origin": [-8.0, 0.0, -8.0],
				"size": [16.0, 1.0, 16.0]
			},
			"minecraft:geometry": "geometry.carpet",
			"minecraft:loot": "loot_tables/blocks/thatch_carpet.json",
			"minecraft:connection_rule": {
				"accepts_connections_from": "none"
			},
			"minecraft:light_dampening": 0,
			"minecraft:sound": {
				"sound": "grass"
			}
		},
		"permutations": [
			{
			"condition": "q.block_state('minecraft:facing_direction') == 'north' || q.block_state('minecraft:facing_direction') == 'south'",
				"components": {
					"minecraft:material_instances": {
						"*": {
							"texture": "thatch_side"
						},
						"end": {
							"texture": "thatch_top"
						},
						"north": "end",
						"south": "end"
					}
				}
			},
			{
			"condition": "q.block_state('minecraft:facing_direction') == 'east' || q.block_state('minecraft:facing_direction') == 'west'",
				"components": {
					"minecraft:material_instances": {
						"*": {
							"texture": "thatch_side"
						},
						"end": {
							"texture": "thatch_top"
						},
						"north": "end",
						"south": "end"
					},
					"minecraft:transformation": { "rotation": [0, 90, 0] }
				}
			}
		]
	}
}
