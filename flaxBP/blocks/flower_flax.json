{
  "format_version": "1.21.100",
  "minecraft:block": {
    "description": {
      "identifier": "flax:flower_flax",
      "menu_category": {
          "category": "none",
          "is_hidden_in_commands": true
        }
    },
    "components": {
      "minecraft:collision_box": false,
      "minecraft:map_color": "#8aa8ff",
      "minecraft:liquid_detection": {
        "detection_rules": [
            {
                "liquid_type": "water",
                "on_liquid_touches": "popped",
                "can_contain_liquid": false
            }
        ]
      },
      "minecraft:light_emission": 0,
      "minecraft:loot": "loot_tables/blocks/flower_flax.json",
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 0
      },
      "minecraft:flammable": {
        "catch_chance_modifier": 30, 
        "destroy_chance_modifier": 100
      },
      "minecraft:geometry": "minecraft:geometry.cross",
      "minecraft:material_instances": {
        "*": {
          "texture": "flower_flax",
          "render_method": "alpha_test_single_sided",
					"face_dimming": false,
					"ambient_occlusion": false
        }
      },
      "minecraft:selection_box": {
        "origin": [-3, 0, -3],
        "size": [6, 13, 6]
      },
      "minecraft:placement_filter": {
        "conditions": [
          {
            "allowed_faces": ["up"],
            "block_filter": ["minecraft:grass_block", "minecraft:dirt", "minecraft:podzol"]
          }
        ]
      },
      "minecraft:movable": {
            	"movement_type": "popped"
			},
      "minecraft:random_offset": {
        "x": {
            "steps": 0,
            "range": {
                "min": -3,
                "max": 3
            }
        },
        "z": {
            "steps": 0,
            "range": {
                "min": -3,
                "max": 3
            }
        }
      }
    }
  }
}
    