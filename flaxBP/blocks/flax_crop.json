{
  "format_version": "1.26.40",
  "minecraft:block": {
    "description": {
      "identifier": "flax:flax_crop",
      "menu_category": {
        "category": "none",
        "is_hidden_in_commands": true
      },
      "states": {
        "flax:growth": {
            "values": { "min": 0, "max": 7 }
        }
      }
    },
    "components": {
      "flax:crop_growth": {
        "growth_state": "flax:growth",
        "max_growth": 7,
        "min_light_level": 9,
        "farmland_search_range": 1,
        "farmland_speed_modifier": 1,
        "farmland_moisture_speed_modifier": 2,
        "neighboring_farmland_speed_multiplier": 0.25,
        "crowding_speed_multiplier": 0.5,
        "growth_on_fertilize": [2, 5]
      },
      "minecraft:collision_box": false,
      "minecraft:placement_filter": {
        "conditions": [
            {
                "allowed_faces": ["up"],
                "block_filter": ["minecraft:farmland"]
            }
        ]
      },
      "minecraft:liquid_detection": {
        "detection_rules": [
            {
                "liquid_type": "water",
                "on_liquid_touches": "popped",
                "can_contain_liquid": false
            }
        ]
      },
      "minecraft:loot": "loot_tables/blocks/crops/flax_crop_young.json",
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 0
      },
      "minecraft:flammable": {
        "catch_chance_modifier": 30, 
        "destroy_chance_modifier": 100
      },
      "minecraft:selection_box": {
          "origin": [-8, 0, -8],
          "size": [16, 2, 16]
      },
      "minecraft:geometry": "geometry.crop",
      "minecraft:light_dampening": 0,
      "minecraft:map_color": "#8aa8ff",
      "minecraft:material_instances": {
          "*": {
            "texture": "flax_crop_0",
            "render_method": "alpha_test",
            "face_dimming": false,
            "ambient_occlusion": 0
          }
      },
			"minecraft:movable": {
            	"movement_type": "popped"
			},
      "minecraft:precipitation_interactions": {
          "precipitation_behavior": "none"
      },
      "minecraft:connection_rule": {
          "accepts_connections_from": "none"
      }
    },
    "permutations": [
        {
            "condition": "q.block_state('flax:growth') < 7",
            "components": {
                "minecraft:loot": "loot_tables/blocks/crops/flax_crop_young.json"
            }
        },
        {
          "condition": "q.block_state('flax:growth') == 0",
          "components": {
              "minecraft:selection_box": {
                  "origin": [-8, 0, -8],
                  "size": [16, 1.6, 16]
              }
          }
        },
        {
          "condition": "q.block_state('flax:growth') == 1",
          "components": {
              "minecraft:selection_box": {
                  "origin": [-8, 0, -8],
                  "size": [16, 3.2, 16]
              }
          }
        },
        {
          "condition": "q.block_state('flax:growth') >= 2",
          "components": {
            "minecraft:material_instances": {
              "*": {
                "texture": "flax_crop_1",
                "render_method": "alpha_test",
                "face_dimming": false,
                "ambient_occlusion": 0
              }
            }
          }
        },
        {
          "condition": "q.block_state('flax:growth') == 2",
          "components": {
              "minecraft:selection_box": {
                  "origin": [-8, 0, -8],
                  "size": [16, 4.8, 16]
              }
          }
        },
        {
          "condition": "q.block_state('flax:growth') == 3",
          "components": {
              "minecraft:selection_box": {
                  "origin": [-8, 0, -8],
                  "size": [16, 6.4, 16]
              }
          }
        },
        {
            "condition": "q.block_state('flax:growth') >= 4",
            "components": {
                "minecraft:material_instances": {
                    "*": {
                    "texture": "flax_crop_2",
                    "render_method": "alpha_test",
                    "face_dimming": false,
                    "ambient_occlusion": 0
                  }
                }
            }
        },
        {
            "condition": "q.block_state('flax:growth') == 4",
            "components": {
                "minecraft:selection_box": {
                    "origin": [-8, 0, -8],
                    "size": [16, 8, 16]
                }
            }
        },
        {
            "condition": "q.block_state('flax:growth') == 5",
            "components": {
                "minecraft:selection_box": {
                    "origin": [-8, 0, -8],
                    "size": [16, 9.6, 16]
                }
            }
        },
        {
            "condition": "q.block_state('flax:growth') == 6",
            "components": {
                "minecraft:selection_box": {
                    "origin": [-8, 0, -8],
                    "size": [16, 11.2, 16]
                }
            }
        },
        {
            "condition": "q.block_state('flax:growth') == 7",
            "components": {
                "minecraft:material_instances": {
                  "*": {
                    "texture": "flax_crop_3",
                    "render_method": "alpha_test",
                    "face_dimming": false,
                    "ambient_occlusion": 0
                  }
                },
                "minecraft:selection_box": {
                    "origin": [-8, 0, -8],
                    "size": [16, 13, 16]
                },
                "minecraft:loot": "loot_tables/blocks/crops/flax_crop_mature.json"
            }
        }
    ]
  }
}
